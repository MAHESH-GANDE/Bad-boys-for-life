generator client {
  provider = "prisma-client-js"
}

// Neon PostgreSQL: use the pooled connection string for DATABASE_URL (app runtime)
// and the direct (non-pooler) string for DIRECT_URL (prisma db push / migrate).
// Both URLs should include ?sslmode=require. See docs/neon-setup.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  ORDER_MANAGER
  MARKETING_MANAGER
  SUPPORT_AGENT
}

enum OrderStatus {
  PENDING
  PENDING_PAYMENT
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURNED
  REFUND_INITIATED
  REFUNDED
  EXCHANGE_REQUESTED
  EXCHANGED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  PAYMENT_FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
  RAZORPAY
}

enum DeliveryMethod {
  STANDARD
  EXPRESS
}

enum CouponType {
  PERCENTAGE
  FLAT
}

enum InventoryBucket {
  AVAILABLE
  RESERVED
  SOLD
  RETURNED
  DAMAGED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  RETURNED
  REFUND_INITIATED
  COMPLETED
}

enum ExchangeStatus {
  REQUESTED
  APPROVED
  REJECTED
  COMPLETED
}

enum CustomerSegment {
  NEW
  ACTIVE
  REPEAT
  HIGH_VALUE
  INACTIVE
}

enum NotificationCategory {
  ORDERS
  PROMOTIONS
  PRODUCT_ALERTS
  ACCOUNT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
  EXPIRED
}

model User {
  id           String    @id @default(uuid())
  mobile       String    @unique
  email        String?   @unique
  name         String?
  dateOfBirth  DateTime?
  referralCode String    @unique
  referredById String?
  referredBy   User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]    @relation("Referrals")
  segment      CustomerSegment @default(NEW)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions     Session[]
  addresses    Address[]
  carts        Cart[]
  wishlist     Wishlist?
  orders       Order[]
  reviews      Review[]
  couponUsages CouponUsage[]
  returns      ReturnRequest[]
  exchanges    ExchangeRequest[]
  notifications Notification[]
  notificationPreference NotificationPreference?
  loyalty      LoyaltyAccount?
  waitlist     WaitlistEntry[]
  otpChallenges OtpChallenge[]
  recentlyViewed RecentlyViewed[]
  searchHistory SearchHistory[]

  @@index([mobile])
  @@index([email])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
  @@index([expiresAt])
}

model OtpChallenge {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mobile    String
  codeHash  String
  purpose   String   @default("login")
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([mobile, purpose])
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  mobile    String
  house     String
  street    String
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([userId])
  @@index([pincode])
}

model AdminUser {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         AdminRole
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     AdminSession[]
  auditLogs    AuditLog[]
}

model AdminSession {
  id        String    @id @default(uuid())
  adminId   String
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

model AuditLog {
  id        String    @id @default(uuid())
  adminId   String?
  admin     AdminUser? @relation(fields: [adminId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  parentId    String?
  parent      Category? @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  products    Product[]
  published   Boolean   @default(true)
  sortOrder   Int       @default(0)

  @@index([slug])
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  banner      String?
  published   Boolean  @default(true)
  sortOrder   Int      @default(0)
  products    CollectionProduct[]
  createdAt   DateTime @default(now())
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int    @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([collectionId, productId])
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  description      String
  shortDescription String
  brand            String   @default("BADBOYS")
  fit              String
  fabric           String
  pattern          String
  neck             String?
  sleeve           String?
  careInstructions String
  hsnCode          String
  gstRate          Decimal  @default(12) @db.Decimal(5, 2)
  seoTitle         String?
  seoDescription   String?
  seoKeywords      String?
  published        Boolean  @default(true)
  isNew            Boolean  @default(false)
  isBestseller     Boolean  @default(false)
  isLimited        Boolean  @default(false)
  isPreorder       Boolean  @default(false)
  expectedDispatch DateTime?
  ratingAvg        Decimal  @default(0) @db.Decimal(3, 2)
  ratingCount      Int      @default(0)
  soldCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  variants   ProductVariant[]
  images     ProductImage[]
  videos     ProductVideo[]
  reviews    Review[]
  collections CollectionProduct[]
  lookItems  LookItem[]
  waitlist   WaitlistEntry[]
  recentlyViewed RecentlyViewed[]

  @@index([slug])
  @@index([categoryId])
  @@index([published])
  @@index([name])
}

model ProductVariant {
  id          String  @id @default(uuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku         String  @unique
  barcode     String?
  colour      String
  colourHex   String
  size        String
  price       Int
  mrp         Int
  weightGrams Int     @default(250)
  lengthCm    Decimal? @db.Decimal(6, 2)
  widthCm     Decimal? @db.Decimal(6, 2)
  heightCm    Decimal? @db.Decimal(6, 2)
  active      Boolean @default(true)

  inventory Inventory?
  cartItems CartItem[]
  orderItems OrderItem[]
  reservations InventoryReservation[]
  waitlist WaitlistEntry[]

  @@unique([productId, colour, size])
  @@index([sku])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  kind      String  @default("front")
  colour    String?
  sortOrder Int     @default(0)
}

model ProductVideo {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int     @default(0)
}

model Inventory {
  id          String         @id @default(uuid())
  variantId   String         @unique
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  available   Int            @default(0)
  reserved    Int            @default(0)
  sold        Int            @default(0)
  returned    Int            @default(0)
  damaged     Int            @default(0)
  lowStockAt  Int            @default(5)
  updatedAt   DateTime       @updatedAt
}

model InventoryReservation {
  id         String            @id @default(uuid())
  variantId  String
  variant    ProductVariant    @relation(fields: [variantId], references: [id])
  quantity   Int
  cartId     String?
  orderId    String?
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())

  @@index([status, expiresAt])
  @@index([variantId])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id])
  sessionId String     @unique
  couponCode String?
  giftWrap  Boolean    @default(false)
  giftMessage String?
  abandonedAt DateTime?
  recoveredAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  @@index([userId])
}

model CartItem {
  id        String         @id @default(uuid())
  cartId    String
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int
  createdAt DateTime       @default(now())

  @@unique([cartId, variantId])
}

model Wishlist {
  id     String         @id @default(uuid())
  userId String         @unique
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items  WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  variantId  String?
  createdAt  DateTime @default(now())

  @@unique([wishlistId, productId, variantId])
}

model Coupon {
  id              String     @id @default(uuid())
  code            String     @unique
  type            CouponType
  value           Int
  minOrder        Int        @default(0)
  maxDiscount     Int?
  firstOrderOnly  Boolean    @default(false)
  productIds      String[]
  categoryIds     String[]
  customerIds     String[]
  startsAt        DateTime
  endsAt          DateTime
  usageLimit      Int?
  usageCount      Int        @default(0)
  active          Boolean    @default(true)
  usages          CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String?  @unique
  createdAt DateTime @default(now())

  @@unique([couponId, userId, orderId])
}

model Order {
  id              String         @id @default(uuid())
  number          String         @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id])
  addressId       String?
  address         Address?       @relation(fields: [addressId], references: [id])
  status          OrderStatus    @default(PENDING_PAYMENT)
  deliveryMethod  DeliveryMethod @default(STANDARD)
  paymentMethod   PaymentMethod
  subtotal        Int
  discount        Int            @default(0)
  shipping        Int            @default(0)
  tax             Int            @default(0)
  codFee          Int            @default(0)
  giftWrapFee     Int            @default(0)
  grandTotal      Int
  couponCode      String?
  notes           String?
  invoiceNumber   String?        @unique
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items     OrderItem[]
  payments  Payment[]
  refunds   Refund[]
  shipment  Shipment?
  returns   ReturnRequest[]
  exchanges ExchangeRequest[]
  shippingSnapshot Json?
  billingSnapshot  Json?

  @@index([userId])
  @@index([status])
  @@index([number])
  @@index([createdAt])
}

model OrderItem {
  id          String         @id @default(uuid())
  orderId     String
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  name        String
  sku         String
  hsnCode     String
  colour      String
  size        String
  quantity    Int
  unitPrice   Int
  mrp         Int
  gstRate     Decimal        @db.Decimal(5, 2)
  taxAmount   Int
  discount    Int            @default(0)
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String        @default("razorpay")
  method            PaymentMethod
  status            PaymentStatus @default(PENDING)
  amount            Int
  currency          String        @default("INR")
  providerOrderId   String?
  providerPaymentId String?
  providerSignature String?
  webhookEventId    String?       @unique
  rawPayload        Json?
  failureReason     String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([providerOrderId])
  @@index([status])
}

model Refund {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  amount     Int
  status     String
  method     String
  providerId String?
  reason     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Shipment {
  id              String   @id @default(uuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courier         String?
  trackingNumber  String?
  awb             String?
  provider        String   @default("shiprocket")
  status          String   @default("pending")
  expectedDelivery DateTime?
  rawPayload      Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Review {
  id         String       @id @default(uuid())
  productId  String
  product    Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  rating     Int
  title      String?
  body       String
  images     String[]
  verified   Boolean      @default(false)
  helpful    Int          @default(0)
  status     ReviewStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([productId, status])
}

model ReturnRequest {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id])
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  reason     String
  notes      String?
  images     String[]
  status     ReturnStatus @default(REQUESTED)
  pickupAwb  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

model ExchangeRequest {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  userId        String
  user          User           @relation(fields: [userId], references: [id])
  fromVariantId String
  toVariantId   String
  reason        String
  status        ExchangeStatus @default(REQUESTED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Notification {
  id        String               @id @default(uuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  NotificationCategory
  title     String
  body      String
  read      Boolean              @default(false)
  link      String?
  createdAt DateTime             @default(now())

  @@index([userId, read])
}

model NotificationPreference {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOrders     Boolean @default(true)
  emailPromos     Boolean @default(true)
  pushOrders      Boolean @default(true)
  pushPromos      Boolean @default(true)
  whatsappOrders  Boolean @default(true)
  whatsappPromos  Boolean @default(false)
  backInStock     Boolean @default(true)
  priceDrop       Boolean @default(true)
}

model Banner {
  id        String    @id @default(uuid())
  slot      String
  title     String
  subtitle  String?
  ctaLabel  String?
  ctaHref   String?
  image     String?
  video     String?
  published Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  sortOrder Int       @default(0)
}

model HomepageSection {
  id        String  @id @default(uuid())
  key       String  @unique
  title     String?
  subtitle  String?
  body      String?
  ctaLabel  String?
  ctaHref   String?
  image     String?
  config    Json?
  published Boolean @default(true)
  sortOrder Int     @default(0)
}

model SiteSetting {
  id    String @id @default("default")
  data  Json
}

model SizeGuide {
  id           String @id @default(uuid())
  categoryKey  String @unique
  title        String
  rows         Json
}

model AnalyticsEvent {
  id        String   @id @default(uuid())
  name      String
  productId String?
  variantId String?
  userId    String?
  sessionId String?
  payload   Json?
  createdAt DateTime @default(now())

  @@index([name, createdAt])
  @@index([sessionId])
}

model Look {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String
  image       String
  published   Boolean   @default(true)
  items       LookItem[]
}

model LookItem {
  lookId    String
  productId String
  sortOrder Int     @default(0)
  look      Look    @relation(fields: [lookId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])

  @@id([lookId, productId])
}

model WaitlistEntry {
  id        String          @id @default(uuid())
  productId String
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  userId    String?
  user      User?           @relation(fields: [userId], references: [id])
  mobile    String?
  email     String?
  notified  Boolean         @default(false)
  createdAt DateTime        @default(now())
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([sessionId, viewedAt])
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  query     String
  createdAt DateTime @default(now())

  @@index([sessionId])
}

model Referral {
  id         String   @id @default(uuid())
  referrerId String
  referredId String
  orderId    String?
  reward     Int      @default(0)
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model LoyaltyAccount {
  id        String @id @default(uuid())
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int    @default(0)
  level     String @default("BADBOY")
  enabled   Boolean @default(false)
}

model GiftCard {
  id        String   @id @default(uuid())
  code      String   @unique
  balance   Int
  expiresAt DateTime?
  active    Boolean  @default(false)
  txs       GiftCardTransaction[]
}

model GiftCardTransaction {
  id         String   @id @default(uuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  amount     Int
  orderId    String?
  createdAt  DateTime @default(now())
}

model Faq {
  id        String  @id @default(uuid())
  topic     String
  question  String
  answer    String
  sortOrder Int     @default(0)
  published Boolean @default(true)
}

model SupportTicket {
  id        String   @id @default(uuid())
  userId    String?
  topic     String
  message   String
  orderId   String?
  email     String?
  mobile    String?
  status    String   @default("open")
  createdAt DateTime @default(now())
}

model PincodeService {
  pincode     String  @id
  city        String
  state       String
  serviceable Boolean @default(true)
  cod         Boolean @default(true)
  express     Boolean @default(false)
  etaDays     Int     @default(5)
}

model Sequence {
  name  String @id
  value Int
}
